# ─────────────────────────────────────────────────────────────
# Inquiry delivery configuration (required for B2B inquiry flow)
# Copy this file to .env.local for local dev, or set these as
# environment variables in Vercel (Settings → Environment Variables).
# NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────

# --- SMTP (primary: sends inquiry to your business email) ---
# NetEase enterprise mail example:
#   SMTP_HOST=smtphz.qiye.163.com
#   SMTP_PORT=465
#   SMTP_USER=Netfactory01@factory-jc.com
#   SMTP_PASS=<your SMTP authorization code, NOT login password>
#   INQUIRY_TO_EMAIL=Netfactory01@factory-jc.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
INQUIRY_TO_EMAIL=

# --- Feishu webhook (optional fallback notification) ---
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
FEISHU_WEBHOOK_URL=
